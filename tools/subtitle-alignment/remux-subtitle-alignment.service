[Unit]
Description=Remux private subtitle alignment worker
After=network.target

[Service]
Type=simple
User=remux-align
Group=remux-align
Environment=ALIGN_RUNTIME=/var/lib/remux-subtitle-alignment
Environment=ALIGN_BIND=10.10.10.1
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
ExecStart=/opt/remux-subtitle-alignment/venv/bin/python /opt/remux-subtitle-alignment/worker.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/remux-subtitle-alignment
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=10.10.10.13/32
IPAddressAllow=10.10.10.1/32
IPAddressAllow=127.0.0.1/32
MemoryMax=2G
CPUQuota=150%
Nice=10
IOSchedulingClass=idle
TasksMax=64

[Install]
WantedBy=multi-user.target
